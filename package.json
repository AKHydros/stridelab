{
  "name": "stridelab",
  "private": true,
  "version": "1.0.0",
  "description": "Endurance running performance analyst with a Liquid Glass interface",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "samples": "esbuild scripts/make-samples.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/make-samples.mjs && node node_modules/.cache/make-samples.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@garmin/fitsdk": "21.217.0",
    "fflate": "0.8.3",
    "leaflet": "1.9.4",
    "papaparse": "5.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "4.2.1",
    "read-excel-file": "5.8.6",
    "recharts": "2.13.3"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.14",
    "@types/papaparse": "5.3.15",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "5.6.3",
    "vite": "^6.4.4",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AKHydros/stridelab.git"
  },
  "homepage": "https://akhydros.github.io/stridelab/"
}
